DATAEXPLORER_ENVIRONMENT=development
DATAEXPLORER_OLLAMA_BASE_URL=http://127.0.0.1:11434
DATAEXPLORER_OLLAMA_CHAT_MODEL=llama3.1:8b
DATAEXPLORER_OLLAMA_EMBEDDING_MODEL=embeddinggemma
DATAEXPLORER_MODEL_PROVIDER=ollama
DATAEXPLORER_DEPLOYMENT_REGION=global
# Optional managed-provider routing (public/internal data only):
# DATAEXPLORER_OPENAI_API_KEY=
# DATAEXPLORER_OPENAI_CHAT_MODEL=gpt-5.4
# DATAEXPLORER_ANTHROPIC_API_KEY=
# DATAEXPLORER_ANTHROPIC_CHAT_MODEL=claude-sonnet-4-5
DATAEXPLORER_RETRIEVAL_LIMIT=5
DATAEXPLORER_MINIMUM_RELEVANCE=0.20
DATAEXPLORER_RERANKER=lexical
DATAEXPLORER_MAX_QUERY_CHARACTERS=8000
DATAEXPLORER_AUTH_MODE=development
DATAEXPLORER_REQUESTS_PER_MINUTE=20
DATAEXPLORER_DAILY_TOKEN_BUDGET=100000
DATAEXPLORER_ARTIFACT_OUTPUT_ROOT=.artifacts
DATAEXPLORER_ARTIFACT_APPROVER_GROUP=content-approvers
# DATAEXPLORER_ARTIFACT_GCS_BUCKET=my-governed-artifacts
# DATAEXPLORER_ARTIFACT_GCS_KMS_KEY=projects/.../cryptoKeys/data
DATAEXPLORER_PERSISTENCE_MODE=memory
# DATAEXPLORER_DATABASE_DSN=postgresql://user:password@localhost:5432/dataexplorer
DATAEXPLORER_POLICY_BACKEND=memory
# DATAEXPLORER_REDIS_URL=redis://localhost:6379/0
DATAEXPLORER_VECTOR_BACKEND=memory
# DATAEXPLORER_QDRANT_URL=http://localhost:6333
# DATAEXPLORER_QDRANT_API_KEY=
DATAEXPLORER_OBSERVABILITY_ADMIN_GROUPS='["observability-admins","platform-admins"]'
# JSON maps keyed by provider or provider:model. Keep changing prices in deployment config.
DATAEXPLORER_LLM_INPUT_COST_PER_MILLION_USD='{"ollama":0}'
DATAEXPLORER_LLM_OUTPUT_COST_PER_MILLION_USD='{"ollama":0}'
DATAEXPLORER_TELEMETRY_RETENTION_DAYS=30
# Required to enable PPTX rendering:
# DATAEXPLORER_ARTIFACT_TOOL_NODE=C:\path\to\node.exe
# DATAEXPLORER_ARTIFACT_TOOL_NODE_MODULES=C:\path\to\node_modules
# Required outside development:
# DATAEXPLORER_OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
# DATAEXPLORER_OIDC_ISSUER=https://identity.example.com/
# DATAEXPLORER_OIDC_AUDIENCE=dataexplorer-api
